rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The owner email is the only account allowed to manage subscription records.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'aaddaa5400@gmail.com';
    }

    function validLicense(licenseId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['email', 'active', 'plan', 'createdAt', 'expiresAt'])
        && data.keys().hasAll(['active', 'plan', 'expiresAt'])
        && data.active is bool
        && data.plan is string
        && data.plan.size() <= 64
        && data.expiresAt is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!licenseId.matches('.*@.*')
          || ('email' in data
            && data.email is string
            && data.email.lower() == licenseId));
    }

    match /licenses/{licenseId} {
      // A customer can read only their email-keyed or legacy UID-keyed license.
      // The owner can read any license to administer subscriptions.
      allow get: if isAdmin()
        || (signedIn()
          && (licenseId == request.auth.uid
            || (request.auth.token.email is string
              && licenseId == request.auth.token.email.lower())));

      // Only the owner may view the subscriber list or modify licenses.
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validLicense(licenseId);
      allow delete: if isAdmin();
    }

    match /customerInbox/{recipient}/messages/{messageId} {
      allow delete: if isAdmin() || (signedIn() && (request.auth.uid == recipient || (request.auth.token.email is string && request.auth.token.email.lower() == recipient)));
      allow read: if isAdmin() || (signedIn() &&
        (request.auth.uid == recipient ||
          (request.auth.token.email is string && request.auth.token.email.lower() == recipient)));
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/licenses/$(recipient))
        && request.resource.data.keys().hasOnly(['text', 'sentAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.sentAt == request.time;
    }

    match /subscriptionRequests/{uid} {
      function validRequest() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'uid', 'name', 'email', 'phone', 'months', 'amount',
            'reference', 'status', 'createdAt'
          ])
          && data.keys().hasAll([
            'uid', 'name', 'email', 'phone', 'months', 'amount', 'status', 'createdAt'
          ])
          && data.uid == uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 80
          && data.email is string && data.email.size() <= 254
          && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 24
          && data.months is int && data.months in [1]
          && data.amount is int && data.amount == data.months * 29
          && (!('reference' in data) || (data.reference is string && data.reference.size() <= 80))
          && data.status == 'pending'
          && data.createdAt == request.time
          && signedIn()
          && request.auth.uid == uid
          && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            || (request.auth.token.email is string
              && request.auth.token.email.lower() == data.email));
      }

      // Customers may submit their own request, or resubmit it after owner review.
      allow create: if validRequest();
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Resubmission replaces a processed request with a fresh pending request.
      // validRequest binds the document to auth.uid, fixes the price/status,
      // and excludes owner-only review/activation fields. Pending requests cannot
      // be overwritten by customers, and licenses remain owner-write-only.
      allow update: if isAdmin()
        || (resource.data.status in ['activated', 'closed', 'rejected']
          && validRequest());
      allow list, delete: if isAdmin();
    }

    // accountDevices/{email-or-uid}: immutable account identity and at most two
    // device records {id: 64 hex characters, label: <=80 chars, addedAt: timestamp}.
    // Customers may append only. The existing owner may remove a device.
    match /accountDevices/{accountId} {
      function ownAccount() {
        return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && (accountId == request.auth.uid || (request.auth.token.email is string
            && accountId == request.auth.token.email.lower()));
      }
      function licensed() {
        let email = request.auth.token.email;
        let primary = /databases/$(database)/documents/licenses/$(email.lower());
        let legacy = /databases/$(database)/documents/licenses/$(request.auth.uid);
        let path = exists(primary) ? primary : legacy;
        return exists(path) && get(path).data.active == true
          && get(path).data.expiresAt is timestamp && get(path).data.expiresAt > request.time;
      }
      function validDevice(device) {
        return device is map && device.keys().hasOnly(['id', 'label', 'addedAt'])
          && device.keys().hasAll(['id', 'label', 'addedAt'])
          && device.id is string && device.id.matches('^[a-f0-9]{64}$')
          && device.label is string && device.label.size() > 0 && device.label.size() <= 80
          && device.addedAt is timestamp;
      }
      function validDevices() {
        let data = request.resource.data;
        return data.keys().hasOnly(['uid', 'email', 'devices', 'updatedAt'])
          && data.keys().hasAll(['uid', 'email', 'devices', 'updatedAt'])
          && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
          && data.email is string && data.email.size() > 0 && data.email.size() <= 254
          && (accountId == data.email || accountId == data.uid)
          && data.devices is list && data.devices.size() <= 2
          && (data.devices.size() == 0 || validDevice(data.devices[0]))
          && (data.devices.size() < 2 || (validDevice(data.devices[1]) && data.devices[0].id != data.devices[1].id))
          && data.updatedAt == request.time;
      }
      function ownIdentity() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email.lower();
      }
      function freshDevice() {
        let device = request.resource.data.devices[request.resource.data.devices.size() - 1];
        return device.addedAt >= request.time - duration.value(5, 'm')
          && device.addedAt <= request.time + duration.value(5, 'm');
      }
      allow get: if isAdmin() || ownAccount();
      allow list: if false;
      allow create: if validDevices() && (isAdmin() || (ownAccount() && licensed()
        && ownIdentity() && request.resource.data.devices.size() == 1 && freshDevice()));
      allow update: if validDevices()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (isAdmin() || (ownAccount() && licensed() && ownIdentity()
          && request.resource.data.devices.size() == resource.data.devices.size() + 1
          && request.resource.data.devices.hasAll(resource.data.devices) && freshDevice()));
      allow delete: if false;
    }

    // Student records stay in browser storage; no other Firestore access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
