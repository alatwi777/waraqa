{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waraqa",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "waraqa-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "waraqa-files" }]
}
